log_info()    { echo -e "${GREEN}[+]${NC} $1"; }
log_warn()    { echo -e "${YELLOW}[!]${NC} $1"; }
log_error()   { echo -e "${RED}[-]${NC} $1"; }
log_section() { echo -e "\n${BOLD}${CYAN}══════════════════════════════════════${NC}"; echo -e "${BOLD}${CYAN}  $1${NC}"; echo -e "${BOLD}${CYAN}══════════════════════════════════════${NC}\n"; }

check_root() {
    if [ "$EUID" -eq 0 ]; then
        log_error "Ne pas lancer ce script en root. Utilise ton user normal."
        exit 1
    fi
}

check_requirements() {
    log_section "Vérification des prérequis"

    # RAM
    TOTAL_RAM=$(free -g | awk '/^Mem:/{print $2}')
    if [ "$TOTAL_RAM" -lt 16 ]; then
        log_warn "RAM détectée : ${TOTAL_RAM}GB. Recommandé : 32GB pour WhiteRabbitNeo 13B"
        log_warn "Tu peux utiliser un modèle plus léger (7B)"
    else
        log_info "RAM : ${TOTAL_RAM}GB ✓"
    fi

    # GPU
    if command -v nvidia-smi &>/dev/null; then
        GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)
        VRAM=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader 2>/dev/null | head -1)
        log_info "GPU détecté : $GPU_NAME ($VRAM) ✓"
    else
        log_warn "Pas de GPU NVIDIA détecté — le modèle tournera en CPU (plus lent)"
    fi

    # Espace disque
    FREE_SPACE=$(df -BG "$HOME" | awk 'NR==2{print $4}' | tr -d 'G')
    if [ "$FREE_SPACE" -lt 30 ]; then
        log_warn "Espace disque libre : ${FREE_SPACE}GB. Recommandé : 30GB minimum"
    else
        log_info "Espace disque : ${FREE_SPACE}GB disponible ✓"
    fi
}

install_dependencies() {
    log_section "Installation des dépendances"

    log_info "Mise à jour des paquets..."
    sudo apt-get update -qq

    log_info "Installation de curl, wget, git, jq..."
    sudo apt-get install -y curl wget git jq python3-pip unzip > /dev/null 2>&1

    # Node.js (requis pour AnythingLLM)
    if ! command -v node &>/dev/null || [ "$(node -v | cut -d. -f1 | tr -d 'v')" -lt 18 ]; then
        log_info "Installation de Node.js 20..."
        curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash - > /dev/null 2>&1
        sudo apt-get install -y nodejs > /dev/null 2>&1
        log_info "Node.js $(node -v) installé ✓"
    else
        log_info "Node.js $(node -v) déjà présent ✓"
    fi

    mkdir -p "$INSTALL_DIR"
    log_info "Dossier de travail : $INSTALL_DIR"
}

install_lm_studio() {
    log_section "Installation de LM Studio (CLI)"

    if command -v lms &>/dev/null; then
        log_info "LM Studio déjà installé ✓"
        return
    fi

    log_info "Téléchargement et installation de LM Studio CLI..."
    curl -fsSL https://lmstudio.ai/install.sh | bash

    # Ajout au PATH
    if ! grep -q "lmstudio" "$HOME/.bashrc"; then
        echo 'export PATH="$HOME/.lmstudio/bin:$PATH"' >> "$HOME/.bashrc"
    fi
    export PATH="$HOME/.lmstudio/bin:$PATH"

    log_info "LM Studio CLI installé ✓"
    log_info "Démarrage du serveur LM Studio sur le port $LM_STUDIO_PORT..."
    nohup lms server start --port $LM_STUDIO_PORT > "$INSTALL_DIR/lmstudio.log" 2>&1 &
    sleep 3
    log_info "Serveur LM Studio actif → http://localhost:$LM_STUDIO_PORT"
}

download_model() {
    log_section "Téléchargement du modèle WhiteRabbitNeo"

    TOTAL_RAM=$(free -g | awk '/^Mem:/{print $2}')

    if [ "$TOTAL_RAM" -ge 32 ]; then
        MODEL="WhiteRabbitNeo/WhiteRabbitNeo-13B-v1"
        log_info "Config détectée : 32GB+ → Téléchargement de WhiteRabbitNeo 13B"
    else
        MODEL="TheBloke/Mistral-7B-Instruct-v0.2-GGUF"
        log_warn "Config < 32GB → Téléchargement de Mistral 7B Instruct (alternatif léger)"
        log_warn "Tu pourras changer pour WhiteRabbitNeo 13B si tu upgrades ta RAM"
    fi

    log_info "Modèle : $MODEL"
    log_warn "Le téléchargement peut prendre plusieurs minutes selon ta connexion..."

    # Téléchargement via lms
    lms get "$MODEL" 2>/dev/null || log_warn "Téléchargement manuel requis via l'interface LM Studio Desktop"

    log_info "Pour charger le modèle : lms load "$MODEL""
    echo "$MODEL" > "$INSTALL_DIR/.current_model"
}

install_anythingllm() {
    log_section "Installation de AnythingLLM"

    ANYTHING_DIR="$INSTALL_DIR/anythingllm"

    if [ -d "$ANYTHING_DIR" ]; then
        log_info "AnythingLLM déjà présent ✓"
    else
        log_info "Téléchargement de AnythingLLM Desktop pour Linux..."
        mkdir -p "$ANYTHING_DIR"

        # Version AppImage
        LATEST_URL="https://cdn.anythingllm.com/latest/AnythingLLMDesktop.AppImage"
        wget -q --show-progress -O "$ANYTHING_DIR/AnythingLLM.AppImage" "$LATEST_URL"
        chmod +x "$ANYTHING_DIR/AnythingLLM.AppImage"

        log_info "AnythingLLM téléchargé ✓"
    fi

    # Création du raccourci de lancement
    cat > "$INSTALL_DIR/start-anythingllm.sh" << 'EOF2'
#!/bin/bash
cd "$HOME/ai-pentest/anythingllm"
./AnythingLLM.AppImage --no-sandbox &
echo "[+] AnythingLLM lancé → http://localhost:3001"
EOF2
    chmod +x "$INSTALL_DIR/start-anythingllm.sh"
    log_info "AnythingLLM prêt ✓"
}

configure_anythingllm() {
    log_section "Configuration automatique AnythingLLM → LM Studio"

    # Attendre qu'AnythingLLM soit dispo
    log_info "Configuration de la connexion LM Studio dans AnythingLLM..."

    CONFIG_DIR="$HOME/.config/anythingllm"
    mkdir -p "$CONFIG_DIR"

    cat > "$CONFIG_DIR/lmstudio-config.json" << EOF
{
  "LLMProvider": "lmstudio",
  "LMStudioBasePath": "http://localhost:${LM_STUDIO_PORT}/v1",
  "LMStudioTokenLimit": 4096,
  "EmbeddingEngine": "native"
}
EOF
    log_info "Config LM Studio écrite ✓"
}

